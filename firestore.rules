rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'luuhvieeira@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function approxEqual(a, b) {
      return (a - b) >= -0.001 && (a - b) <= 0.001;
    }

    function initialCleanCashTarget() {
      return exists(/databases/$(database)/documents/economyConfig/global)
        && ('initialCleanCash' in get(/databases/$(database)/documents/economyConfig/global).data)
        ? get(/databases/$(database)/documents/economyConfig/global).data.initialCleanCash
        : 500;
    }

    function initialBankBalanceTarget() {
      return exists(/databases/$(database)/documents/economyConfig/global)
        && ('initialBankBalance' in get(/databases/$(database)/documents/economyConfig/global).data)
        ? get(/databases/$(database)/documents/economyConfig/global).data.initialBankBalance
        : 1000;
    }

    // 3. Entity Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    function isValidCharacterProfile(data, expectedUid) {
      return data.keys().hasAll([
          'uid', 'characterName', 'alias', 'origin', 'district',
          'coatColor', 'accentColor', 'skinTone', 'style',
          'level', 'reputation', 'cashBalance', 'bankBalance',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'characterName', 'alias', 'origin', 'district',
          'coatColor', 'accentColor', 'skinTone', 'style',
          'level', 'experience', 'reputation', 'cashBalance', 'bankBalance',
          'lastX', 'lastZ', 'lastRotY',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == expectedUid
        && data.characterName is string
        && data.characterName.size() >= 3 && data.characterName.size() <= 32
        && data.characterName.matches('^[a-zA-Z0-9À-ÿ _\\-]+$')
        && data.alias is string
        && data.alias.size() >= 2 && data.alias.size() <= 24
        && data.alias.matches('^[a-zA-Z0-9_\\-]+$')
        && data.origin in ['comerciante', 'operario', 'corretor', 'independente']
        && data.district in ['distrito-central']
        && isHexColor(data.coatColor)
        && isHexColor(data.accentColor)
        && isHexColor(data.skinTone)
        && data.style in ['executivo', 'urbano', 'tatico']
        && data.level is number && data.level >= 1 && data.level <= 100
        && (!('experience' in data) || (data.experience is number && data.experience >= 0 && data.experience <= 10000000))
        && data.reputation is number && data.reputation >= -1000 && data.reputation <= 100000
        && data.cashBalance is number && data.cashBalance >= 0 && data.cashBalance <= 1000000000
        && data.bankBalance is number && data.bankBalance >= 0 && data.bankBalance <= 1000000000
        && (!('lastX' in data) || (data.lastX is number && data.lastX >= -36 && data.lastX <= 36))
        && (!('lastZ' in data) || (data.lastZ is number && data.lastZ >= -36 && data.lastZ <= 36))
        && (!('lastRotY' in data) || (data.lastRotY is number && data.lastRotY >= -7 && data.lastRotY <= 7))
        && data.status in ['active', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data, expectedUid) {
      return data.keys().hasAll(['uid', 'email', 'provider', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'provider', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.provider in ['google', 'password']
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidAdminRecord(data, expectedUid) {
      return data.keys().hasAll(['uid', 'role', 'label', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'label', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.role in ['super_admin', 'economy_admin', 'moderator']
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 64
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidEconomyConfig(data, expectedId) {
      return data.keys().hasAll([
          'id', 'cityName', 'taxRatePercent', 'baseSalaryHourly',
          'baseFuelPrice', 'basePropertyPrice', 'marketOpen',
          'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'cityName', 'taxRatePercent', 'baseSalaryHourly',
          'baseFuelPrice', 'basePropertyPrice',
          'initialCleanCash', 'initialBankBalance', 'defaultMaxDailyPayouts',
          'marketOpen', 'updatedBy', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id == expectedId
        && data.cityName is string && data.cityName.size() >= 3 && data.cityName.size() <= 64
        && data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 50
        && data.baseSalaryHourly is number && data.baseSalaryHourly >= 10 && data.baseSalaryHourly <= 10000
        && data.baseFuelPrice is number && data.baseFuelPrice >= 1 && data.baseFuelPrice <= 500
        && data.basePropertyPrice is number && data.basePropertyPrice >= 1000 && data.basePropertyPrice <= 10000000
        && (!('initialCleanCash' in data) || (data.initialCleanCash is number && data.initialCleanCash >= 0 && data.initialCleanCash <= 1000000))
        && (!('initialBankBalance' in data) || (data.initialBankBalance is number && data.initialBankBalance >= 0 && data.initialBankBalance <= 1000000))
        && (!('defaultMaxDailyPayouts' in data) || (data.defaultMaxDailyPayouts is number && data.defaultMaxDailyPayouts >= 1 && data.defaultMaxDailyPayouts <= 100))
        && data.marketOpen is bool
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidWallet(data, expectedUid) {
      return data.keys().hasAll([
          'uid', 'cleanCash', 'dirtyCash', 'companiesValue', 'realEstateValue',
          'vehiclesValue', 'investmentsValue', 'otherAssetsValue', 'lastTxId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'cleanCash', 'dirtyCash', 'companiesValue', 'realEstateValue',
          'vehiclesValue', 'investmentsValue', 'otherAssetsValue', 'lastTxId',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.cleanCash is number && data.cleanCash >= 0 && data.cleanCash <= 1000000000
        && data.dirtyCash is number && data.dirtyCash >= 0 && data.dirtyCash <= 1000000000
        && data.companiesValue is number && data.companiesValue >= 0 && data.companiesValue <= 1000000000
        && data.realEstateValue is number && data.realEstateValue >= 0 && data.realEstateValue <= 1000000000
        && data.vehiclesValue is number && data.vehiclesValue >= 0 && data.vehiclesValue <= 1000000000
        && data.investmentsValue is number && data.investmentsValue >= 0 && data.investmentsValue <= 1000000000
        && data.otherAssetsValue is number && data.otherAssetsValue >= 0 && data.otherAssetsValue <= 1000000000
        && data.lastTxId is string && data.lastTxId.size() >= 1 && data.lastTxId.size() <= 128 && isValidId(data.lastTxId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBankAccount(data, expectedUid) {
      return data.keys().hasAll([
          'uid', 'accountNumber', 'bankName', 'balance', 'status', 'lastTxId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'accountNumber', 'bankName', 'balance', 'status', 'lastTxId', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.accountNumber is string && data.accountNumber.size() >= 6 && data.accountNumber.size() <= 24 && data.accountNumber.matches('^[A-Z0-9\\-]+$')
        && data.bankName is string && data.bankName.size() >= 3 && data.bankName.size() <= 48
        && data.balance is number && data.balance >= 0 && data.balance <= 1000000000
        && data.status in ['active', 'frozen']
        && data.lastTxId is string && data.lastTxId.size() >= 1 && data.lastTxId.size() <= 128 && isValidId(data.lastTxId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBankDirectory(data, expectedUid) {
      return data.keys().hasAll(['uid', 'characterName', 'alias', 'accountNumber', 'active', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'characterName', 'alias', 'accountNumber', 'active', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.characterName is string && data.characterName.size() >= 3 && data.characterName.size() <= 32
        && data.alias is string && data.alias.size() >= 2 && data.alias.size() <= 24
        && data.accountNumber is string && data.accountNumber.size() >= 6 && data.accountNumber.size() <= 24
        && data.active is bool
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidTransaction(data, expectedId) {
      return data.keys().hasAll([
          'id', 'operationId', 'type', 'currencyCategory', 'amount',
          'fromUid', 'fromLabel', 'toUid', 'toLabel', 'actorUid',
          'participants', 'description', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'operationId', 'type', 'currencyCategory', 'amount',
          'fromUid', 'fromLabel', 'toUid', 'toLabel', 'actorUid',
          'participants', 'description', 'status', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 128 && data.id == expectedId
        && data.operationId is string && data.operationId.size() >= 4 && data.operationId.size() <= 128 && isValidId(data.operationId)
        && data.type in [
          'deposit', 'withdraw', 'transfer', 'salary', 'admin_adjustment',
          'business_purchase', 'business_sale', 'business_payroll', 'business_capital',
          'vehicle_purchase', 'vehicle_p2p_sale', 'vehicle_maintenance', 'vehicle_commission'
        ]
        && data.currencyCategory in ['clean_cash', 'bank', 'dirty_cash']
        && data.amount is number && data.amount > 0 && data.amount <= 100000000
        && data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128
        && data.fromLabel is string && data.fromLabel.size() >= 1 && data.fromLabel.size() <= 64
        && data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128
        && data.toLabel is string && data.toLabel.size() >= 1 && data.toLabel.size() <= 64
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 2
        && data.participants[0] is string && data.participants[0].size() <= 128
        && (data.participants.size() == 1 || (data.participants[1] is string && data.participants[1].size() <= 128))
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 180
        && data.status == 'completed'
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidJobDefinition(data, expectedId) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'baseSalary', 'durationSeconds',
          'cooldownSeconds', 'maxDailyPayouts', 'minLevel', 'requiredExperience',
          'xpReward', 'reputationReward', 'available', 'isCatalogJob', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'baseSalary', 'durationSeconds',
          'cooldownSeconds', 'maxDailyPayouts', 'minLevel', 'requiredExperience',
          'xpReward', 'reputationReward', 'available', 'isCatalogJob', 'updatedBy', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 40 && data.id == expectedId
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 64
        && data.description is string && data.description.size() >= 6 && data.description.size() <= 240
        && data.baseSalary is number && data.baseSalary >= 10 && data.baseSalary <= 50000
        && data.durationSeconds is number && data.durationSeconds >= 10 && data.durationSeconds <= 3600
        && data.cooldownSeconds is number && data.cooldownSeconds >= 5 && data.cooldownSeconds <= 86400
        && data.maxDailyPayouts is number && data.maxDailyPayouts >= 1 && data.maxDailyPayouts <= 100
        && data.minLevel is number && data.minLevel >= 1 && data.minLevel <= 100
        && data.requiredExperience is number && data.requiredExperience >= 0 && data.requiredExperience <= 100000
        && data.xpReward is number && data.xpReward >= 1 && data.xpReward <= 5000
        && data.reputationReward is number && data.reputationReward >= 0 && data.reputationReward <= 500
        && data.available is bool
        && data.isCatalogJob == true
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidWorkSession(data, expectedId) {
      return data.keys().hasAll([
          'id', 'uid', 'jobId', 'jobName', 'status', 'durationSeconds', 'expectedSalary', 'xpReward', 'startedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'jobId', 'jobName', 'status', 'durationSeconds', 'expectedSalary', 'xpReward',
          'startedAt', 'completedAt', 'payoutTxId'
        ])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 128 && data.id == expectedId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.jobId in ['entregador', 'supermercado', 'motorista', 'mecanico']
        && data.jobName is string && data.jobName.size() >= 3 && data.jobName.size() <= 64
        && data.status in ['in_progress', 'completed', 'cancelled']
        && data.durationSeconds is number && data.durationSeconds >= 10 && data.durationSeconds <= 3600
        && data.expectedSalary is number && data.expectedSalary >= 10 && data.expectedSalary <= 100000
        && data.xpReward is number && data.xpReward >= 1 && data.xpReward <= 5000
        && data.startedAt is timestamp
        && (!('completedAt' in data) || data.completedAt is timestamp)
        && (!('payoutTxId' in data) || (data.payoutTxId is string && data.payoutTxId.size() <= 128));
    }

    function isValidSalaryPayment(data, expectedId) {
      return data.keys().hasAll([
          'id', 'sessionId', 'uid', 'jobId', 'jobName', 'amount', 'xpAwarded', 'tierLabel', 'txId', 'paidAt'
        ])
        && data.keys().hasOnly([
          'id', 'sessionId', 'uid', 'jobId', 'jobName', 'amount', 'xpAwarded', 'tierLabel', 'txId', 'paidAt'
        ])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 128 && data.id == expectedId
        && data.sessionId is string && data.sessionId == expectedId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.jobId in ['entregador', 'supermercado', 'motorista', 'mecanico']
        && data.jobName is string && data.jobName.size() >= 3 && data.jobName.size() <= 64
        && data.amount is number && data.amount >= 10 && data.amount <= 100000
        && data.xpAwarded is number && data.xpAwarded >= 1 && data.xpAwarded <= 5000
        && data.tierLabel in ['Iniciante', 'Intermediário', 'Experiente', 'Especialista', 'Mestre']
        && data.txId is string && data.txId.size() >= 4 && data.txId.size() <= 128 && isValidId(data.txId)
        && data.paidAt is timestamp && data.paidAt == request.time;
    }

    function isValidJobExperience(data, expectedUid) {
      return data.keys().hasAll([
          'uid', 'totalXp', 'entregadorXp', 'supermercadoXp', 'motoristaXp', 'mecanicoXp',
          'lastSessionId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'totalXp', 'entregadorXp', 'supermercadoXp', 'motoristaXp', 'mecanicoXp',
          'lastSessionId', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.totalXp is number && data.totalXp >= 0 && data.totalXp <= 10000000
        && data.entregadorXp is number && data.entregadorXp >= 0 && data.entregadorXp <= 10000000
        && data.supermercadoXp is number && data.supermercadoXp >= 0 && data.supermercadoXp <= 10000000
        && data.motoristaXp is number && data.motoristaXp >= 0 && data.motoristaXp <= 10000000
        && data.mecanicoXp is number && data.mecanicoXp >= 0 && data.mecanicoXp <= 10000000
        && data.lastSessionId is string && data.lastSessionId.size() >= 1 && data.lastSessionId.size() <= 128 && isValidId(data.lastSessionId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'summary', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'action', 'targetUid', 'summary', 'createdAt'])
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.action in [
          'update_economy_config',
          'bootstrap_admin',
          'update_citizen_status',
          'update_job_config',
          'admin_balance_adjustment',
          'create_business_location',
          'update_business_location',
          'admin_business_action',
          'create_vehicle_model',
          'update_vehicle_model',
          'suspend_vehicle_listing',
          'admin_vehicle_action'
        ]
        && (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128))
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 240
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidBusinessTemplate(t) {
      return t in [
        'concessionaria', 'supermercado', 'oficina', 'transportadora', 'restaurante',
        'imobiliaria', 'seguranca', 'loja_roupas', 'posto_combustivel', 'entretenimento'
      ];
    }

    function isValidBusinessLocation(data, expectedId) {
      return data.keys().hasAll([
          'id', 'templateType', 'name', 'category', 'description',
          'acquisitionPrice', 'initialCapital', 'operatingExpense', 'maxEmployees',
          'revenuePotential', 'minPriceMultiplier', 'maxPriceMultiplier',
          'locationLabel', 'posX', 'posZ', 'available', 'isCatalogLocation',
          'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'templateType', 'name', 'category', 'description',
          'acquisitionPrice', 'initialCapital', 'operatingExpense', 'maxEmployees',
          'revenuePotential', 'minPriceMultiplier', 'maxPriceMultiplier',
          'locationLabel', 'posX', 'posZ', 'available', 'isCatalogLocation',
          'updatedBy', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 64 && data.id == expectedId
        && isValidBusinessTemplate(data.templateType)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 64
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 48
        && data.description is string && data.description.size() >= 6 && data.description.size() <= 240
        && data.acquisitionPrice is number && data.acquisitionPrice >= 50 && data.acquisitionPrice <= 100000000
        && data.initialCapital is number && data.initialCapital >= 0 && data.initialCapital <= 50000000
        && data.operatingExpense is number && data.operatingExpense >= 0 && data.operatingExpense <= 10000000
        && data.maxEmployees is number && data.maxEmployees >= 1 && data.maxEmployees <= 100
        && data.revenuePotential is number && data.revenuePotential >= 10 && data.revenuePotential <= 100000000
        && data.minPriceMultiplier is number && data.minPriceMultiplier >= 1.0 && data.minPriceMultiplier <= 5.0
        && data.maxPriceMultiplier is number && data.maxPriceMultiplier >= data.minPriceMultiplier && data.maxPriceMultiplier <= 10.0
        && data.locationLabel is string && data.locationLabel.size() >= 3 && data.locationLabel.size() <= 80
        && data.posX is number && data.posX >= -40 && data.posX <= 40
        && data.posZ is number && data.posZ >= -40 && data.posZ <= 40
        && data.available is bool
        && data.isCatalogLocation == true
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidBusinessRecord(data, expectedId) {
      return data.keys().hasAll([
          'id', 'locationId', 'templateType', 'name', 'category', 'description',
          'ownerUid', 'ownerName', 'ownerAlias', 'status',
          'acquisitionPrice', 'marketValue', 'operatingExpense', 'maxEmployees',
          'growthLevel', 'employeeCount', 'reputation', 'reputationCount',
          'forSale', 'salePrice', 'locationLabel', 'posX', 'posZ',
          'lastTxId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'locationId', 'templateType', 'name', 'category', 'description',
          'ownerUid', 'ownerName', 'ownerAlias', 'status',
          'acquisitionPrice', 'marketValue', 'operatingExpense', 'maxEmployees',
          'growthLevel', 'employeeCount', 'reputation', 'reputationCount',
          'forSale', 'salePrice', 'locationLabel', 'posX', 'posZ',
          'lastTxId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 3 && data.id.size() <= 128 && data.id == expectedId
        && data.locationId is string && data.locationId.size() >= 2 && data.locationId.size() <= 64
        && isValidBusinessTemplate(data.templateType)
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 64
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 48
        && data.description is string && data.description.size() >= 6 && data.description.size() <= 240
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 64
        && data.ownerAlias is string && data.ownerAlias.size() >= 2 && data.ownerAlias.size() <= 32
        && data.status in ['active', 'inactive_funds', 'suspended']
        && data.acquisitionPrice is number && data.acquisitionPrice >= 50 && data.acquisitionPrice <= 100000000
        && data.marketValue is number && data.marketValue >= 50 && data.marketValue <= 500000000
        && data.operatingExpense is number && data.operatingExpense >= 0 && data.operatingExpense <= 10000000
        && data.maxEmployees is number && data.maxEmployees >= 1 && data.maxEmployees <= 100
        && data.growthLevel is number && data.growthLevel >= 1 && data.growthLevel <= 10
        && data.employeeCount is number && data.employeeCount >= 0 && data.employeeCount <= data.maxEmployees
        && data.reputation is number && data.reputation >= 0 && data.reputation <= 100
        && data.reputationCount is number && data.reputationCount >= 0 && data.reputationCount <= 1000000
        && data.forSale is bool
        && data.salePrice is number && data.salePrice >= 0 && data.salePrice <= 500000000
        && data.locationLabel is string && data.locationLabel.size() >= 3 && data.locationLabel.size() <= 80
        && data.posX is number && data.posX >= -40 && data.posX <= 40
        && data.posZ is number && data.posZ >= -40 && data.posZ <= 40
        && data.lastTxId is string && data.lastTxId.size() >= 1 && data.lastTxId.size() <= 128 && isValidId(data.lastTxId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusinessFinance(data, expectedBizId) {
      return data.keys().hasAll([
